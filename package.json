    "@nextui-org/react": "^2.6.11",
    "axios": "^1.6.0",
    "exifr": "^7.1.3",
    "fabric": "^5.3.0",
    "jszip": "^3.10.1",
    "next": "14.0.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.0",
